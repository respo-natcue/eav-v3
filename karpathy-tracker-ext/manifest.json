{
  "manifest_version": 3,
  "name": "Andrej Karpathy Updates",
  "version": "1.0",
  "description": "Get the latest blogs and X (Twitter) posts from Andrej Karpathy.",
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "assets/icon-16.png",
      "48": "assets/icon-48.png",
      "128": "assets/icon-128.png"
    }
  },
  "icons": {
    "16": "assets/icon-16.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://karpathy.github.io/*",
    "https://syndication.twitter.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  }
}
